# Local development only. Copy to .env and export, e.g. `set -a; . ./.env; set +a`.
# The passwords in these URLs are local-only (Docker's Postgres trusts local connections).
# Owner role: runs migrations and seed.
DATABASE_URL=postgresql://cafm:cafm@localhost:5432/cafm_dev
# Application role: no ownership, so row-level security always applies.
APP_DATABASE_URL=postgresql://cafm_app:cafm_app@localhost:5432/cafm_dev
REDIS_URL=redis://localhost:6379
# Shows the demo accounts on the login page. Never true in production.
DEMO_MODE=true
API_PORT=4000
API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# Optional Helpdesk mail connector and non-demo browser push.
HELPDESK_INBOUND_TOKEN=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
# Docker Compose's MinIO needs a root password: choose any 8+ characters.
MINIO_ROOT_PASSWORD=
# Hosted deploys only (see docs/deploy/railway.md): the cafm_app role's password,
# used to build APP_DATABASE_URL from DATABASE_URL, and the number of proxies in front of the API.
# APP_DB_PASSWORD=
# TRUST_PROXY_HOPS=1
