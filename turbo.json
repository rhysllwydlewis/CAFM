{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["API_URL", "NODE_ENV"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@cafm/db#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "@cafm/db#test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@cafm/web#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/design/icons/sprite.svg",
        "$TURBO_ROOT$/design/icons/logo/logomark.svg",
        "$TURBO_ROOT$/design/mockups/src/styles.css",
        "$TURBO_ROOT$/design/tokens/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "public/icons.svg", "public/favicon.svg"],
      "env": ["API_URL", "NODE_ENV"]
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "APP_DATABASE_URL",
    "SHADOW_DATABASE_URL",
    "REDIS_URL",
    "DEMO_MODE",
    "API_PORT",
    "WEB_ORIGIN",
    "CI"
  ]
}
