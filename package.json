{
  "name": "fmstead",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @fmstead/db migrate:deploy",
    "db:seed": "turbo run build --filter=@fmstead/db... && pnpm --filter @fmstead/db seed",
    "e2e": "pnpm --filter @fmstead/web e2e",
    "start": "node scripts/start.mjs",
    "release": "node scripts/release.mjs",
    "fmstead": "node packages/db/dist/cli.js",
    "progress": "node scripts/progress.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
