/// An estate location. Parent and child must belong to the same tenant.
model Location {
  id               String           @id @default(uuid(7)) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  parentId         String?          @map("parent_id") @db.Uuid
  name             String
  kind             String
  code             String
  status           String           @default("open")
  custom           Json             @default("{}")
  details          Json             @default("{}")
  siteCalendar     Json?            @map("site_calendar")
  restrictedAccess String?          @map("restricted_access")
  version          Int              @default(1)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  parent           Location?        @relation("LocationParent", fields: [tenantId, parentId], references: [tenantId, id], onDelete: NoAction)
  children         Location[]       @relation("LocationParent")
  ancestors        LocationPath[]   @relation("LocationDescendant")
  descendants      LocationPath[]   @relation("LocationAncestor")
  grants           MembershipSite[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, parentId])
  @@index([tenantId, kind])
  @@map("location")
}

/// Indexed ancestor relationships, including each location's link to itself.
model LocationPath {
  tenantId     String   @map("tenant_id") @db.Uuid
  ancestorId   String   @map("ancestor_id") @db.Uuid
  descendantId String   @map("descendant_id") @db.Uuid
  ancestor     Location @relation("LocationAncestor", fields: [tenantId, ancestorId], references: [tenantId, id], onDelete: Cascade)
  descendant   Location @relation("LocationDescendant", fields: [tenantId, descendantId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, ancestorId, descendantId])
  @@index([tenantId, descendantId])
  @@map("location_path")
}

/// Access to the named location and all its descendants.
model MembershipSite {
  tenantId     String     @map("tenant_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  locationId   String     @map("location_id") @db.Uuid
  membership   Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  location     Location   @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, membershipId, locationId])
  @@index([tenantId, locationId])
  @@map("membership_site")
}
