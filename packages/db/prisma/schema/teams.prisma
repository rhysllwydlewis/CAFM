// Teams and groups (doc 03): named sets of people used for assignment and scoping.

/// A team inside one tenant, for example "North Region Electricians". Tenant-owned (RLS).
model Team {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  members     TeamMember[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("team")
}

/// A person's place in a team. Tenant-owned (RLS); team and person must be in the same tenant.
model TeamMember {
  tenantId     String     @map("tenant_id") @db.Uuid
  teamId       String     @map("team_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  addedAt      DateTime   @default(now()) @map("added_at") @db.Timestamptz(3)
  team         Team       @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Cascade)
  membership   Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, teamId, membershipId])
  @@index([tenantId, membershipId])
  @@map("team_member")
}

// Modules and terminology (doc 03 § Admin: switch modules on or off, rename them, rename any label).

/// A tenant's choice for one module: on or off, its own name for it, and its place in the menu. Tenant-owned (RLS).
/// No row means the default: on, the standard name, the standard order.
model ModuleSetting {
  tenantId  String   @map("tenant_id") @db.Uuid
  moduleKey String   @map("module_key")
  enabled   Boolean  @default(true)
  /// The organisation's own name for the module, for example "Jobs".
  label     String?
  /// Menu position within the module's section. Null keeps the standard order.
  position  Int?
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@id([tenantId, moduleKey])
  @@map("module_setting")
}

/// A tenant's own word for a standard term, for example "Work order" becomes "Job". Tenant-owned (RLS).
model TermOverride {
  tenantId  String   @map("tenant_id") @db.Uuid
  termKey   String   @map("term_key")
  singular  String
  plural    String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@id([tenantId, termKey])
  @@map("term_override")
}

/// An organisation's look: its accent colour and sign-in message (doc 02 branding). One row per tenant (RLS).
model TenantBranding {
  tenantId     String   @id @map("tenant_id") @db.Uuid
  /// Hex colour such as #136676, checked for AA contrast with white text before it is saved.
  accentColour String?  @map("accent_colour")
  /// Shown on the requester portal's sign-in screen.
  loginMessage String?  @map("login_message")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@map("tenant_branding")
}
