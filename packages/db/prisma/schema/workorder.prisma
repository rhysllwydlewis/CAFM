/// A reactive job at a location, usually raised from a Helpdesk request.
/// Status, priority and the three SLA targets are stored on the job so later edits to the
/// priority matrix never rewrite history.
model WorkOrder {
  id                 String                @id @default(uuid(7)) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  number             String
  type               String                @default("reactive")
  title              String
  description        String
  status             String                @default("logged")
  pauseReason        String?               @map("pause_reason")
  /// Set while the job is paused for a reason that stops the SLA clock. The targets move on when work resumes.
  slaPausedAt        DateTime?             @map("sla_paused_at") @db.Timestamptz(3)
  /// The business time the clock has been stopped for, for display. The targets already include it.
  slaPausedMinutes   Int                   @default(0) @map("sla_paused_minutes")
  locationId         String                @map("location_id") @db.Uuid
  assetId            String?               @map("asset_id") @db.Uuid
  requestId          String?               @map("request_id") @db.Uuid
  assigneeId         String?               @map("assignee_id") @db.Uuid
  /// For a PPM job: the asset on a schedule it was raised for, and the day the visit is due.
  ppmScheduleAssetId String?               @map("ppm_schedule_asset_id") @db.Uuid
  scheduledFor       DateTime?             @map("scheduled_for") @db.Date
  createdById        String?               @map("created_by_id") @db.Uuid
  impact             Int
  urgency            Int
  priority           Int
  responseDueAt      DateTime?             @map("response_due_at") @db.Timestamptz(3)
  attendDueAt        DateTime?             @map("attend_due_at") @db.Timestamptz(3)
  fixDueAt           DateTime?             @map("fix_due_at") @db.Timestamptz(3)
  firstResponseAt    DateTime?             @map("first_response_at") @db.Timestamptz(3)
  attendedAt         DateTime?             @map("attended_at") @db.Timestamptz(3)
  completedAt        DateTime?             @map("completed_at") @db.Timestamptz(3)
  verifiedAt         DateTime?             @map("verified_at") @db.Timestamptz(3)
  closedAt           DateTime?             @map("closed_at") @db.Timestamptz(3)
  custom             Json                  @default("{}")
  /// The currency every cost on the job is in. Money is whole minor units (pence) plus this code.
  currency           String                @default("GBP")
  /// A not-to-exceed limit on the job's costs, in minor units. Spend over it needs a recorded reason.
  nteMinor           Int?                  @map("nte_minor")
  submissionKey      String                @map("submission_key")
  submissionHash     String                @map("submission_hash")
  version            Int                   @default(1)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             Tenant                @relation(fields: [tenantId], references: [id])
  location           Location              @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  asset              Asset?                @relation(fields: [tenantId, assetId], references: [tenantId, id], onDelete: Restrict)
  request            ServiceRequest?       @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict)
  assignee           Membership?           @relation("WorkOrderAssignee", fields: [tenantId, assigneeId], references: [tenantId, id], onDelete: Restrict)
  createdBy          Membership?           @relation("WorkOrderCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict)
  ppmScheduleAsset   PpmScheduleAsset?     @relation(fields: [tenantId, ppmScheduleAssetId], references: [tenantId, id], onDelete: Restrict)
  entries            WorkOrderEntry[]
  contractors        WorkOrderContractor[]
  notifications      Notification[]
  costs              WorkOrderCost[]
  times              WorkOrderTime[]
  checklists         WorkOrderChecklist[]
  signatures         WorkOrderSignature[]
  attachments        RecordAttachment[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, submissionKey])
  @@unique([tenantId, ppmScheduleAssetId, scheduledFor])
  @@index([tenantId, status, fixDueAt])
  @@index([tenantId, assigneeId, status])
  @@index([tenantId, requestId])
  @@index([tenantId, assetId])
  @@index([tenantId, locationId, createdAt])
  @@index([tenantId, createdAt, id])
  @@map("work_order")
}

/// The job's timeline: status changes, assignment and notes. Internal entries are for staff only.
model WorkOrderEntry {
  id          String      @id @default(uuid(7)) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  workOrderId String      @map("work_order_id") @db.Uuid
  authorId    String?     @map("author_id") @db.Uuid
  /// Who an outside party (a contractor on a link) was, when there is no member to name.
  actorName   String?     @map("actor_name")
  kind        String
  body        String
  internal    Boolean     @default(false)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  workOrder   WorkOrder   @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Cascade)
  author      Membership? @relation(fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, workOrderId, createdAt, id])
  @@map("work_order_entry")
}

/// An outside contractor asked to do a job. They have no account: the job is sent to them as a link whose
/// token is stored only as a hash, and the link stops working when it expires or is withdrawn.
model WorkOrderContractor {
  id          String      @id @default(uuid(7)) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  workOrderId String      @map("work_order_id") @db.Uuid
  name        String
  email       String
  tokenHash   String      @unique @map("token_hash")
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime?   @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt  DateTime?   @map("last_used_at") @db.Timestamptz(3)
  createdById String?     @map("created_by_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  workOrder   WorkOrder   @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Cascade)
  createdBy   Membership? @relation(fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, workOrderId, createdAt])
  @@map("work_order_contractor")
}

/// A cost recorded against a job. The amount is worked out on the server from quantity and unit cost, in whole
/// minor units, and the job's currency applies. Entries are removed, not edited, so each change is in the audit log.
model WorkOrderCost {
  id            String         @id @default(uuid(7)) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  workOrderId   String         @map("work_order_id") @db.Uuid
  /// labour, parts, subcontract or expense.
  kind          String
  /// For labour: on_site, travel or overtime.
  labourType    String?        @map("labour_type")
  description   String
  /// An invoice or part number.
  reference     String?
  /// Thousandths of a unit: hours for labour, items for parts, 1000 for a single amount.
  quantityMilli Int            @map("quantity_milli")
  unitCostMinor Int            @map("unit_cost_minor")
  amountMinor   Int            @map("amount_minor")
  incurredOn    DateTime       @map("incurred_on") @db.Date
  recordedById  String?        @map("recorded_by_id") @db.Uuid
  /// Set when this entry took the job over its not-to-exceed limit, with the reason that was given.
  overNte       Boolean        @default(false) @map("over_nte")
  overNteReason String?        @map("over_nte_reason")
  /// Set when the cost was posted from time recorded on the job.
  timeId        String?        @map("time_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  workOrder     WorkOrder      @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Cascade)
  recordedBy    Membership?    @relation(fields: [tenantId, recordedById], references: [tenantId, id], onDelete: Restrict)
  time          WorkOrderTime? @relation(fields: [tenantId, timeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, workOrderId, createdAt, id])
  @@map("work_order_cost")
}

/// A reusable checklist an organisation keeps. The steps are copied onto a job when it is used, so changing a
/// template later never rewrites a job's record.
model ChecklistTemplate {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  /// none, start or completion: what the checklist holds back on a job.
  gate        String   @default("none")
  /// The steps: a list of { label, kind, required, unit? }.
  items       Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("checklist_template")
}

/// A checklist on one job, with its own copy of the steps.
model WorkOrderChecklist {
  id          String                   @id @default(uuid(7)) @db.Uuid
  tenantId    String                   @map("tenant_id") @db.Uuid
  workOrderId String                   @map("work_order_id") @db.Uuid
  title       String
  /// none, start or completion: what the checklist holds back.
  gate        String                   @default("none")
  createdById String?                  @map("created_by_id") @db.Uuid
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant      Tenant                   @relation(fields: [tenantId], references: [id])
  workOrder   WorkOrder                @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Cascade)
  createdBy   Membership?              @relation(fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict)
  items       WorkOrderChecklistItem[]

  @@unique([tenantId, id])
  @@index([tenantId, workOrderId, createdAt, id])
  @@map("work_order_checklist")
}

model WorkOrderChecklistItem {
  id             String             @id @default(uuid(7)) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  checklistId    String             @map("checklist_id") @db.Uuid
  position       Int
  /// tick, pass_fail, number or text.
  kind           String
  label          String
  required       Boolean            @default(false)
  unit           String?
  /// tick: done. pass_fail: pass, fail or na. number: a decimal. text: the comment. Null until answered.
  answer         String?
  note           String?
  answeredById   String?            @map("answered_by_id") @db.Uuid
  /// Who answered when it was someone outside the organisation on a contractor link.
  answeredByName String?            @map("answered_by_name")
  answeredAt     DateTime?          @map("answered_at") @db.Timestamptz(3)
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  checklist      WorkOrderChecklist @relation(fields: [tenantId, checklistId], references: [tenantId, id], onDelete: Cascade)
  answeredBy     Membership?        @relation(fields: [tenantId, answeredById], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, checklistId, position])
  @@map("work_order_checklist_item")
}

/// A sign-off on a job: the customer's or the technician's. The drawing is kept as a private attachment.
model WorkOrderSignature {
  id           String           @id @default(uuid(7)) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  workOrderId  String           @map("work_order_id") @db.Uuid
  /// customer or technician. A job has at most one of each.
  role         String
  signerName   String           @map("signer_name")
  attachmentId String           @map("attachment_id") @db.Uuid
  recordedById String?          @map("recorded_by_id") @db.Uuid
  signedAt     DateTime         @default(now()) @map("signed_at") @db.Timestamptz(3)
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  workOrder    WorkOrder        @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Cascade)
  attachment   RecordAttachment @relation(fields: [tenantId, attachmentId], references: [tenantId, id], onDelete: Cascade)
  recordedBy   Membership?      @relation(fields: [tenantId, recordedById], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, workOrderId, role])
  @@unique([tenantId, attachmentId])
  @@map("work_order_signature")
}

/// A change made on a phone, kept by its idempotency key so a retry after a dropped connection is answered, not repeated.
model MobileMutation {
  id          String     @id @default(uuid(7)) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  memberId    String     @map("member_id") @db.Uuid
  /// Made on the phone before the change is sent.
  key         String     @db.Uuid
  kind        String
  /// A hash of what was sent, so the same key with different content is refused.
  requestHash String     @map("request_hash")
  /// pending while the change runs, then applied, or rejected with a reason the phone shows.
  outcome     String
  result      Json       @default("{}")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  member      Membership @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, memberId, key])
  @@map("mobile_mutation")
}

/// What an organisation pays for an hour of work, by kind of labour and optionally by role. `roleKey` is empty for
/// everyone without a rate of their own. Money is whole minor units.
model LabourRate {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  labourType  String   @map("labour_type")
  roleKey     String   @default("") @map("role_key")
  rateMinor   Int      @map("rate_minor")
  currency    String   @default("GBP")
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, labourType, roleKey])
  @@map("labour_rate")
}

/// Time a person spent on a job. The rate is copied from the labour rate when it is recorded, and the cost it
/// makes is posted to the job, so a later change of rate never rewrites what was recorded.
model WorkOrderTime {
  id          String          @id @default(uuid(7)) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  workOrderId String          @map("work_order_id") @db.Uuid
  memberId    String          @map("member_id") @db.Uuid
  labourType  String          @map("labour_type")
  minutes     Int
  workedOn    DateTime        @map("worked_on") @db.Date
  note        String?
  rateMinor   Int?            @map("rate_minor")
  submission  String          @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  workOrder   WorkOrder       @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Cascade)
  member      Membership      @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Restrict)
  cost        WorkOrderCost[]

  @@unique([tenantId, id])
  @@unique([tenantId, memberId, submission])
  @@index([tenantId, workOrderId, createdAt, id])
  @@map("work_order_time")
}
