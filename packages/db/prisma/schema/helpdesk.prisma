/// An independently selectable request type in the tenant's service catalogue.
model RequestType {
  id                   String           @id @default(uuid(7)) @db.Uuid
  tenantId             String           @map("tenant_id") @db.Uuid
  name                 String
  category             String
  problemCode          String           @map("problem_code")
  questions            Json             @default("[]")
  defaultImpact        Int              @default(2) @map("default_impact")
  duplicateWindowHours Int              @default(48) @map("duplicate_window_hours")
  defaultUrgency       Int              @default(2) @map("default_urgency")
  acknowledgement      String?
  assigneeId           String?          @map("assignee_id") @db.Uuid
  active               Boolean          @default(true)
  version              Int              @default(1)
  tenant               Tenant           @relation(fields: [tenantId], references: [id])
  assignee             Membership?      @relation("RequestTypeAssignee", fields: [tenantId, assigneeId], references: [tenantId, id], onDelete: Restrict)
  requests             ServiceRequest[]
  mailboxes            RequestMailbox[]

  @@unique([tenantId, id])
  @@unique([tenantId, category, problemCode, name])
  @@map("request_type")
}

model RequestPriority {
  id              String  @id @default(uuid(7)) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  impact          Int
  urgency         Int
  priority        Int
  responseMinutes Int     @map("response_minutes")
  attendMinutes   Int     @map("attend_minutes")
  fixMinutes      Int     @map("fix_minutes")
  businessHours   Boolean @default(true) @map("business_hours")
  tenant          Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, impact, urgency])
  @@map("request_priority")
}

/// Status and timing are captured per request so catalogue edits preserve history.
model ServiceRequest {
  id               String                   @id @default(uuid(7)) @db.Uuid
  tenantId         String                   @map("tenant_id") @db.Uuid
  number           String
  title            String
  description      String
  locationId       String                   @map("location_id") @db.Uuid
  assetId          String?                  @map("asset_id") @db.Uuid
  typeId           String                   @map("type_id") @db.Uuid
  requesterId      String?                  @map("requester_id") @db.Uuid
  externalEmail    String?                  @map("external_email")
  assigneeId       String?                  @map("assignee_id") @db.Uuid
  channel          String
  status           String                   @default("new")
  impact           Int
  urgency          Int
  priority         Int
  responseDueAt    DateTime?                @map("response_due_at") @db.Timestamptz(3)
  attendDueAt      DateTime?                @map("attend_due_at") @db.Timestamptz(3)
  fixDueAt         DateTime?                @map("fix_due_at") @db.Timestamptz(3)
  firstResponseAt  DateTime?                @map("first_response_at") @db.Timestamptz(3)
  mergedIntoId     String?                  @map("merged_into_id") @db.Uuid
  ratedAt          DateTime?                @map("rated_at") @db.Timestamptz(3)
  rating           Int?
  feedback         String?
  custom           Json                     @default("{}")
  answers          Json                     @default("{}")
  submissionKey    String                   @map("submission_key")
  submissionHash   String                   @map("submission_hash")
  version          Int                      @default(1)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant           Tenant                   @relation(fields: [tenantId], references: [id])
  location         Location                 @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  asset            Asset?                   @relation(fields: [tenantId, assetId], references: [tenantId, id], onDelete: Restrict)
  type             RequestType              @relation(fields: [tenantId, typeId], references: [tenantId, id], onDelete: Restrict)
  requester        Membership?              @relation("RequestOwner", fields: [tenantId, requesterId], references: [tenantId, id], onDelete: Restrict)
  assignee         Membership?              @relation("RequestAssignee", fields: [tenantId, assigneeId], references: [tenantId, id], onDelete: Restrict)
  mergedInto       ServiceRequest?          @relation("RequestMerge", fields: [tenantId, mergedIntoId], references: [tenantId, id], onDelete: NoAction)
  duplicates       ServiceRequest[]         @relation("RequestMerge")
  entries          RequestEntry[]
  notifications    Notification[]
  receivedMessages ReceivedRequestMessage[]
  workOrders       WorkOrder[]
  attachments      RecordAttachment[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, submissionKey])
  @@index([tenantId, status, responseDueAt])
  @@index([tenantId, requesterId, createdAt, id])
  @@index([tenantId, assigneeId, status])
  @@index([tenantId, mergedIntoId])
  @@index([tenantId, locationId, typeId, createdAt])
  @@index([tenantId, createdAt, id])
  @@map("service_request")
}

model RequestEntry {
  id        String         @id @default(uuid(7)) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  requestId String         @map("request_id") @db.Uuid
  authorId  String?        @map("author_id") @db.Uuid
  kind      String
  body      String
  internal  Boolean        @default(false)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  request   ServiceRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Cascade)
  author    Membership?    @relation(fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, requestId, createdAt, id])
  @@map("request_entry")
}

model RequestMailbox {
  id         String                   @id @default(uuid(7)) @db.Uuid
  tenantId   String                   @map("tenant_id") @db.Uuid
  address    String
  locationId String                   @map("location_id") @db.Uuid
  typeId     String                   @map("type_id") @db.Uuid
  active     Boolean                  @default(true)
  version    Int                      @default(1)
  tenant     Tenant                   @relation(fields: [tenantId], references: [id])
  location   Location                 @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  type       RequestType              @relation(fields: [tenantId, typeId], references: [tenantId, id], onDelete: Restrict)
  messages   ReceivedRequestMessage[]

  @@unique([tenantId, id])
  @@unique([tenantId, address])
  @@map("request_mailbox")
}

model ReceivedRequestMessage {
  id        String         @id @default(uuid(7)) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  mailboxId String         @map("mailbox_id") @db.Uuid
  requestId String         @map("request_id") @db.Uuid
  messageId String         @map("message_id")
  sender    String
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  mailbox   RequestMailbox @relation(fields: [tenantId, mailboxId], references: [tenantId, id], onDelete: Cascade)
  request   ServiceRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, mailboxId, messageId, sender], map: "received_request_message_delivery_key")
  @@index([tenantId, requestId])
  @@map("received_request_message")
}

model Notification {
  id             String                     @id @default(uuid(7)) @db.Uuid
  tenantId       String                     @map("tenant_id") @db.Uuid
  recipientId    String?                    @map("recipient_id") @db.Uuid
  requestId      String?                    @map("request_id") @db.Uuid
  assetId        String?                    @map("asset_id") @db.Uuid
  recipientEmail String?                    @map("recipient_email")
  pushEnabled    Boolean                    @default(true) @map("push_enabled")
  eventKey       String                     @map("event_key")
  title          String
  body           String
  readAt         DateTime?                  @map("read_at") @db.Timestamptz(3)
  emailSentAt    DateTime?                  @map("email_sent_at") @db.Timestamptz(3)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant         Tenant                     @relation(fields: [tenantId], references: [id])
  recipient      Membership?                @relation(fields: [tenantId, recipientId], references: [tenantId, id], onDelete: Cascade)
  request        ServiceRequest?            @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Cascade)
  asset          Asset?                     @relation(fields: [tenantId, assetId], references: [tenantId, id], onDelete: Cascade)
  pushDeliveries NotificationPushDelivery[]

  @@unique([tenantId, id])
  @@unique([tenantId, eventKey])
  @@index([tenantId, recipientId, createdAt, id])
  @@map("notification")
}

model NotificationTemplate {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  key      String
  title    String
  body     String
  email    Boolean @default(true)
  push     Boolean @default(true)
  tenant   Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("notification_template")
}

model PushSubscription {
  id           String                     @id @default(uuid(7)) @db.Uuid
  tenantId     String                     @map("tenant_id") @db.Uuid
  membershipId String                     @map("membership_id") @db.Uuid
  endpoint     String
  p256dh       String
  auth         String
  tenant       Tenant                     @relation(fields: [tenantId], references: [id])
  membership   Membership                 @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  deliveries   NotificationPushDelivery[]

  @@unique([tenantId, id])
  @@unique([tenantId, membershipId, endpoint])
  @@map("push_subscription")
}

model NotificationPushDelivery {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  notificationId String           @map("notification_id") @db.Uuid
  subscriptionId String           @map("subscription_id") @db.Uuid
  sentAt         DateTime         @default(now()) @map("sent_at") @db.Timestamptz(3)
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  notification   Notification     @relation(fields: [tenantId, notificationId], references: [tenantId, id], onDelete: Cascade)
  subscription   PushSubscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, notificationId, subscriptionId])
  @@map("notification_push_delivery")
}
