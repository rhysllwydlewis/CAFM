// Identity and tenancy (ADR 0004: global account, per-tenant membership).

/// A customer organisation. Platform-level table (no RLS); only exposed through memberships.
model Tenant {
  id                         String                     @id @default(uuid(7)) @db.Uuid
  slug                       String                     @unique
  name                       String
  plan                       String
  status                     String                     @default("active")
  /// Demo tenants never send email or SMS: it is captured instead (doc 06).
  demo                       Boolean                    @default(false)
  createdAt                  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships                Membership[]
  invites                    Invite[]
  fields                     FieldDefinition[]
  sequences                  NumberSequence[]
  configVersions             ConfigVersion[]
  roles                      Role[]
  auditEvents                AuditEvent[]
  outbox                     OutboxMessage[]
  entitlements               TenantEntitlement[]
  locations                  Location[]
  assetClasses               AssetClass[]
  assets                     Asset[]
  assetServes                AssetServes[]
  assetTags                  AssetTag[]
  assetMeters                AssetMeter[]
  assetMeterReadings         AssetMeterReading[]
  assetWarranties            AssetWarranty[]
  warrantyClaims             WarrantyClaim[]
  recordAttachments          RecordAttachment[]
  attachmentContents         AttachmentContent[]
  requestTypes               RequestType[]
  requestPriorities          RequestPriority[]
  requests                   ServiceRequest[]
  workOrders                 WorkOrder[]
  workOrderEntries           WorkOrderEntry[]
  workOrderContractors       WorkOrderContractor[]
  requestEntries             RequestEntry[]
  requestMailboxes           RequestMailbox[]
  receivedRequestMessages    ReceivedRequestMessage[]
  notifications              Notification[]
  notificationTemplates      NotificationTemplate[]
  pushSubscriptions          PushSubscription[]
  notificationPushDeliveries NotificationPushDelivery[]
  workOrderCosts             WorkOrderCost[]
  checklistTemplates         ChecklistTemplate[]
  ppmTaskTemplates           PpmTaskTemplate[]
  ppmSchedules               PpmSchedule[]
  ppmScheduleAssets          PpmScheduleAsset[]
  workOrderChecklists        WorkOrderChecklist[]
  workOrderChecklistItems    WorkOrderChecklistItem[]
  workOrderSignatures        WorkOrderSignature[]
  mobileMutations            MobileMutation[]
  labourRates                LabourRate[]
  workOrderTimes             WorkOrderTime[]

  @@map("tenant")
}

/// A person who can sign in. Global; one account can belong to several tenants.
model Account {
  id              String          @id @default(uuid(7)) @db.Uuid
  email           String?         @unique
  username        String?         @unique
  name            String
  passwordHash    String          @map("password_hash")
  failedAttempts  Int             @default(0) @map("failed_attempts")
  lockedUntil     DateTime?       @map("locked_until") @db.Timestamptz(3)
  isDemo          Boolean         @default(false) @map("is_demo")
  /// Version of the terms of service accepted, and when (doc 06: accept-invite).
  termsVersion    String?         @map("terms_version")
  termsAcceptedAt DateTime?       @map("terms_accepted_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships     Membership[]
  sessions        Session[]
  passwordResets  PasswordReset[]
  mobileDevices   MobileDevice[]
  oauthCodes      OauthCode[]

  @@map("account")
}

/// An account's role and licence inside one tenant. Tenant-owned (RLS).
model Membership {
  id                   String                   @id @default(uuid(7)) @db.Uuid
  tenantId             String                   @map("tenant_id") @db.Uuid
  accountId            String                   @map("account_id") @db.Uuid
  role                 String
  licence              String
  title                String?
  landingPage          String                   @default("/app") @map("landing_page")
  status               String                   @default("active")
  locationScoped       Boolean                  @default(false) @map("location_scoped")
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant               Tenant                   @relation(fields: [tenantId], references: [id])
  account              Account                  @relation(fields: [accountId], references: [id])
  sessions             Session[]
  mobileDevices        MobileDevice[]
  oauthCodes           OauthCode[]
  sites                MembershipSite[]
  requestTypes         RequestType[]            @relation("RequestTypeAssignee")
  ownRequests          ServiceRequest[]         @relation("RequestOwner")
  assignedRequests     ServiceRequest[]         @relation("RequestAssignee")
  assignedWorkOrders   WorkOrder[]              @relation("WorkOrderAssignee")
  createdWorkOrders    WorkOrder[]              @relation("WorkOrderCreator")
  workOrderEntries     WorkOrderEntry[]
  requestEntries       RequestEntry[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  workOrderContractors WorkOrderContractor[]
  workOrderCosts       WorkOrderCost[]
  workOrderChecklists  WorkOrderChecklist[]
  ppmSchedules         PpmSchedule[]
  checklistItemAnswers WorkOrderChecklistItem[]
  workOrderSignatures  WorkOrderSignature[]
  mobileMutations      MobileMutation[]
  workOrderTimes       WorkOrderTime[]

  @@unique([tenantId, id])
  @@unique([tenantId, accountId])
  @@index([accountId])
  @@map("membership")
}

/// A signed-in browser session. Only the SHA-256 of the token is stored.
model Session {
  id           String        @id @default(uuid(7)) @db.Uuid
  tokenHash    String        @unique @map("token_hash")
  accountId    String        @map("account_id") @db.Uuid
  membershipId String?       @map("membership_id") @db.Uuid
  tenantId     String?       @map("tenant_id") @db.Uuid
  /// Set for a mobile access token (P1-06a): the signed-in device it belongs to.
  deviceId     String?       @map("device_id") @db.Uuid
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz(3)
  ip           String?
  userAgent    String?       @map("user_agent")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  membership   Membership?   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  device       MobileDevice? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([deviceId])
  @@map("session")
}

/// A phone or tablet signed in to the mobile PWA by OAuth 2.0 + PKCE (P1-06a).
/// Global like sessions (ADR 0004): it names the membership, not a tenant.
/// The refresh token rotates on every use; the previous hash is kept so a
/// replayed (stolen) token revokes the device.
model MobileDevice {
  id               String     @id @default(uuid(7)) @db.Uuid
  accountId        String     @map("account_id") @db.Uuid
  membershipId     String     @map("membership_id") @db.Uuid
  name             String
  refreshHash      String     @unique @map("refresh_hash")
  previousHash     String?    @map("previous_hash")
  refreshExpiresAt DateTime   @map("refresh_expires_at") @db.Timestamptz(3)
  lastSeenAt       DateTime   @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  lastIp           String?    @map("last_ip")
  revokedAt        DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  account          Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  membership       Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  sessions         Session[]

  @@index([accountId])
  @@index([previousHash])
  @@map("mobile_device")
}

/// A one-use PKCE authorisation code, valid for 60 seconds.
model OauthCode {
  id            String     @id @default(uuid(7)) @db.Uuid
  codeHash      String     @unique @map("code_hash")
  codeChallenge String     @map("code_challenge")
  accountId     String     @map("account_id") @db.Uuid
  membershipId  String     @map("membership_id") @db.Uuid
  deviceName    String     @map("device_name")
  expiresAt     DateTime   @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  account       Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  membership    Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@map("oauth_code")
}

/// Sign-in audit trail (success, failure, lockout, sign-out). No passwords, ever.
model AuthEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  type       String
  accountId  String?  @map("account_id") @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  identifier String?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([accountId])
  @@map("auth_event")
}

/// Single-use password reset token (doc 06). Only the SHA-256 is stored; 30-minute expiry.
model PasswordReset {
  id        String    @id @default(uuid(7)) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("password_reset")
}

/// An invitation to join a tenant with a role (doc 06 accept-invite). Tenant-owned (RLS).
model Invite {
  id                    String    @id @default(uuid(7)) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  email                 String
  role                  String
  licence               String
  tokenHash             String    @unique @map("token_hash")
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt            DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(3)
  invitedByMembershipId String?   @map("invited_by_membership_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant                Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, email])
  @@map("invite")
}

/// Email that was captured instead of sent: demo tenants, or no mail server configured (doc 06).
model CapturedEmail {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  to        String
  subject   String
  text      String
  reason    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([to, createdAt])
  @@map("captured_email")
}
