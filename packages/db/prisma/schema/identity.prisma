// Identity and tenancy (ADR 0004: global account, per-tenant membership).

/// A customer organisation. Platform-level table (no RLS); only exposed through memberships.
model Tenant {
  id           String              @id @default(uuid(7)) @db.Uuid
  slug         String              @unique
  name         String
  plan         String
  status       String              @default("active")
  /// Demo tenants never send email or SMS: it is captured instead (doc 06).
  demo         Boolean             @default(false)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships  Membership[]
  invites      Invite[]
  roles        Role[]
  auditEvents  AuditEvent[]
  outbox       OutboxMessage[]
  entitlements TenantEntitlement[]

  @@map("tenant")
}

/// A person who can sign in. Global; one account can belong to several tenants.
model Account {
  id              String          @id @default(uuid(7)) @db.Uuid
  email           String?         @unique
  username        String?         @unique
  name            String
  passwordHash    String          @map("password_hash")
  failedAttempts  Int             @default(0) @map("failed_attempts")
  lockedUntil     DateTime?       @map("locked_until") @db.Timestamptz(3)
  isDemo          Boolean         @default(false) @map("is_demo")
  /// Version of the terms of service accepted, and when (doc 06: accept-invite).
  termsVersion    String?         @map("terms_version")
  termsAcceptedAt DateTime?       @map("terms_accepted_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships     Membership[]
  sessions        Session[]
  passwordResets  PasswordReset[]

  @@map("account")
}

/// An account's role and licence inside one tenant. Tenant-owned (RLS).
model Membership {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  role        String
  licence     String
  title       String?
  landingPage String    @default("/app") @map("landing_page")
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  account     Account   @relation(fields: [accountId], references: [id])
  sessions    Session[]

  @@unique([tenantId, accountId])
  @@index([accountId])
  @@map("membership")
}

/// A signed-in browser session. Only the SHA-256 of the token is stored.
model Session {
  id           String      @id @default(uuid(7)) @db.Uuid
  tokenHash    String      @unique @map("token_hash")
  accountId    String      @map("account_id") @db.Uuid
  membershipId String?     @map("membership_id") @db.Uuid
  tenantId     String?     @map("tenant_id") @db.Uuid
  expiresAt    DateTime    @map("expires_at") @db.Timestamptz(3)
  ip           String?
  userAgent    String?     @map("user_agent")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  account      Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("session")
}

/// Sign-in audit trail (success, failure, lockout, sign-out). No passwords, ever.
model AuthEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  type       String
  accountId  String?  @map("account_id") @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  identifier String?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([accountId])
  @@map("auth_event")
}

/// Single-use password reset token (doc 06). Only the SHA-256 is stored; 30-minute expiry.
model PasswordReset {
  id        String    @id @default(uuid(7)) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("password_reset")
}

/// An invitation to join a tenant with a role (doc 06 accept-invite). Tenant-owned (RLS).
model Invite {
  id                    String    @id @default(uuid(7)) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  email                 String
  role                  String
  licence               String
  tokenHash             String    @unique @map("token_hash")
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt            DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(3)
  invitedByMembershipId String?   @map("invited_by_membership_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant                Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, email])
  @@map("invite")
}

/// Email that was captured instead of sent: demo tenants, or no mail server configured (doc 06).
model CapturedEmail {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  to        String
  subject   String
  text      String
  reason    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([to, createdAt])
  @@map("captured_email")
}
